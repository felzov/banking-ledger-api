# Copy to .env for local development: cp .env.example .env
# Synthetic, local-only values. Never put real credentials in this file.

APP_ENV=development

# The database admin (the PostgreSQL bootstrap superuser). Used only by the db service and the
# one-shot role bootstrap, never by the migrations or the API.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ledger

# The roles the bootstrap creates (ADR 0015): ledger_owner runs the migrations, ledger_app is the
# API's identity. 16+ characters; they are written into connection URLs unescaped, so use only
# letters, digits and . _ ~ -
LEDGER_OWNER_PASSWORD=local-owner-not-a-secret
LEDGER_APP_PASSWORD=local-app-not-a-secret

# Host ports (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
API_PORT=8000
